// CraftKhoj — Prisma schema (PostgreSQL)
// Mirrors Design.md §13 entities and §14 sample SQL.
// Table and column names map to the snake_case names in the design document.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  ARTISAN
  VERIFIER
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  DEACTIVATED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  SIMULATED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum OrderStatus {
  PLACED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id           Int        @id @default(autoincrement())
  fullName     String     @db.VarChar(100) @map("full_name")
  email        String     @unique @db.VarChar(150)
  passwordHash String     @db.VarChar(255) @map("password_hash")
  role         Role       @default(BUYER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")

  artisanProfile   ArtisanProfile?
  orders           Order[]
  reviews          Review[]
  reportsSubmitted Report[]        @relation("ReportReporter")
  reportsResolved  Report[]        @relation("ReportResolver")
  provenanceEvents ProvenanceEvent[]
  cartItems        CartItem[]
  verifications    VerificationLog[]
  productsVerified ProvenanceRecord[] @relation("ProvenanceVerifier")

  @@map("users")
}

model ArtisanProfile {
  id                 Int             @id @default(autoincrement())
  userId             Int             @unique @map("user_id")
  craftSpecialty     String?         @db.VarChar(150) @map("craft_specialty")
  bio                String?
  district           String?         @db.VarChar(100)
  workshopAddress    String?         @map("workshop_address")
  yearsExperience    Int             @default(0) @map("years_experience")
  portraitUrl        String?         @map("portrait_url")
  verificationStatus ApprovalStatus  @default(PENDING) @map("verification_status")
  verificationNote   String?         @map("verification_note")
  trustScore         Decimal         @default(0) @db.Decimal(5, 2) @map("trust_score")
  createdAt          DateTime        @default(now()) @map("created_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  products         Product[]
  verificationLogs VerificationLog[]

  @@map("artisan_profiles")
}

model CraftCategory {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  description String?
  products    Product[]

  @@map("craft_categories")
}

model Product {
  id                Int           @id @default(autoincrement())
  artisanId         Int           @map("artisan_id")
  categoryId        Int           @map("category_id")
  title             String        @db.VarChar(200)
  description       String?
  price             Decimal       @db.Decimal(10, 2)
  stock             Int           @default(0)
  status            ProductStatus @default(PENDING)
  provenanceId      String?       @unique @db.VarChar(30) @map("provenance_id")
  origin            String?       @db.VarChar(150)
  productionMethod  String?       @map("production_method")
  productionDate    DateTime?     @map("production_date")
  processImageUrl   String?       @map("process_image_url")
  riskScore         Int           @default(0) @map("risk_score")
  isFeatured        Boolean       @default(false) @map("is_featured")
  tags              String        @default("") @db.VarChar(300)
  createdAt         DateTime      @default(now()) @map("created_at")

  artisan          ArtisanProfile   @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  category         CraftCategory    @relation(fields: [categoryId], references: [id])
  images           ProductImage[]
  materials        ProductMaterial[]
  provenanceRecord ProvenanceRecord?
  orderItems       OrderItem[]
  reviews          Review[]
  reports          Report[]
  cartItems        CartItem[]

  @@map("products")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  imageUrl  String  @map("image_url")
  isPrimary Boolean @default(false) @map("is_primary")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model Material {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(100)

  products ProductMaterial[]

  @@map("materials")
}

model ProductMaterial {
  productId            Int    @map("product_id")
  materialId           Int    @map("material_id")
  quantityOrPercentage String? @db.VarChar(100) @map("quantity_or_percentage")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])

  @@id([productId, materialId])
  @@map("product_materials")
}

model ProvenanceRecord {
  id                 Int            @id @default(autoincrement())
  productId          Int            @unique @map("product_id")
  workshopLocation   String?        @db.VarChar(200) @map("workshop_location")
  productionDate     DateTime?      @map("production_date")
  productionMethod   String?        @map("production_method")
  processNotes       String?        @map("process_notes")
  processImageUrl    String?        @map("process_image_url")
  verificationStatus ApprovalStatus @default(PENDING) @map("verification_status")
  verificationNote   String?        @map("verification_note")
  verifierId         Int?           @map("verifier_id")
  verifiedAt         DateTime?      @map("verified_at")
  createdAt          DateTime       @default(now()) @map("created_at")

  product  Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  verifier User?             @relation("ProvenanceVerifier", fields: [verifierId], references: [id])
  events   ProvenanceEvent[]
  verificationLogs VerificationLog[]

  @@map("provenance_records")
}

model ProvenanceEvent {
  id                Int            @id @default(autoincrement())
  provenanceRecordId Int           @map("provenance_record_id")
  eventType         String         @db.VarChar(50) @map("event_type")
  description       String?
  performedById     Int?           @map("performed_by")
  eventTime         DateTime       @default(now()) @map("event_time")

  provenanceRecord ProvenanceRecord @relation(fields: [provenanceRecordId], references: [id], onDelete: Cascade)
  performedBy      User?            @relation(fields: [performedById], references: [id])

  @@map("provenance_events")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  buyerId   Int      @map("buyer_id")
  productId Int      @map("product_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  buyer   User    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([buyerId, productId])
  @@map("cart_items")
}

model Order {
  id            Int           @id @default(autoincrement())
  buyerId       Int           @map("buyer_id")
  totalAmount   Decimal       @db.Decimal(10, 2) @map("total_amount")
  paymentMethod PaymentMethod @default(CASH_ON_DELIVERY) @map("payment_method")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  orderStatus   OrderStatus   @default(PLACED) @map("order_status")
  shippingName  String?       @map("shipping_name")
  shippingPhone String?       @map("shipping_phone")
  shippingAddress String?     @map("shipping_address")
  createdAt     DateTime      @default(now()) @map("created_at")

  buyer     User        @relation(fields: [buyerId], references: [id])
  orderItems OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  productId Int     @map("product_id")
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2) @map("unit_price")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  buyerId   Int      @map("buyer_id")
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer   User    @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@unique([productId, buyerId])
  @@map("reviews")
}

model Report {
  id           Int          @id @default(autoincrement())
  productId    Int          @map("product_id")
  reporterId   Int          @map("reporter_id")
  reason       String
  description  String?      @db.Text
  status       ReportStatus @default(OPEN)
  adminRemarks String?      @map("admin_remarks")
  resolvedById Int?         @map("resolved_by")
  createdAt    DateTime     @default(now()) @map("created_at")

  product   Product @relation(fields: [productId], references: [id])
  reporter  User    @relation("ReportReporter", fields: [reporterId], references: [id])
  resolvedBy User?  @relation("ReportResolver", fields: [resolvedById], references: [id])

  @@map("reports")
}

model VerificationLog {
  id                Int                @id @default(autoincrement())
  verifierId        Int                @map("verifier_id")
  decision          ApprovalStatus
  remarks           String?            @db.Text
  artisanProfileId  Int?               @map("artisan_profile_id")
  provenanceRecordId Int?              @map("provenance_record_id")
  createdAt         DateTime           @default(now()) @map("created_at")

  verifier         User              @relation(fields: [verifierId], references: [id])
  artisanProfile   ArtisanProfile?   @relation(fields: [artisanProfileId], references: [id])
  provenanceRecord ProvenanceRecord? @relation(fields: [provenanceRecordId], references: [id])

  @@map("verification_logs")
}
